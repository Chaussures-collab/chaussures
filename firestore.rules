rules_version = '2';

function isUserAuthenticated() {
  return request.auth != null;
}

function isUserOwner(userId) {
  return request.auth.uid == userId;
}

function isUserAdmin() {
  return request.auth.token.admin == true;
}

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Règles pour les utilisateurs
    match /users/{userId} {
      allow read, write: if isUserAuthenticated() && (isUserOwner(userId) || isUserAdmin());
    }

    // Règles pour les produits
    match /products/{productId} {
      allow read: if true; 
      allow create: if isUserAuthenticated(); // Tous les utilisateurs connectés peuvent ajouter des produits
      allow update, delete: if isUserAuthenticated(); 
    }
    
    // Règles pour les catégories
    match /categories/{categoryId} {
      allow read: if true; 
      allow create: if isUserAuthenticated(); // Tous les utilisateurs connectés peuvent ajouter des catégories
      allow update, delete: if isUserAuthenticated(); 
    }
    
    // Règles pour les commandes
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    
    // Règles pour les paniers abandonnés
    match /abandonedCarts/{cartId} {
      allow read: if isUserAuthenticated(); // Seuls les utilisateurs connectés peuvent lire
      allow create: if isUserAuthenticated(); // Tous les utilisateurs connectés peuvent créer un panier abandonné
      allow update, delete: if isUserAuthenticated(); // Tous les utilisateurs connectés peuvent mettre à jour/supprimer
    }
    
    // Règles pour les notifications de stock
    match /stockNotifications/{notificationId} {
      allow read: if isUserAuthenticated(); // Seuls les utilisateurs connectés peuvent lire
      allow create: if true; // Même les utilisateurs non connectés peuvent s'abonner
      allow update, delete: if isUserAuthenticated(); // Seuls les utilisateurs connectés peuvent mettre à jour/supprimer
    }
  }
}


